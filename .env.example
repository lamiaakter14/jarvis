# ============================================
# JARVIS Configuration - Example
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env file to Git!
#
# Generate secure secrets with:
#   openssl rand -hex 32

# ============================================
# Environment
# ============================================
ENVIRONMENT=development
# Options: development, staging, production

# ============================================
# API Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
# Number of Uvicorn workers (use 1 for development, 4+ for production)

API_RELOAD=true
# Auto-reload on code changes (development only, set to false in production)

API_DEBUG=true
# Debug mode (development only, set to false in production)

# ============================================
# Security & Authentication
# ============================================
# CRITICAL: Generate new keys for production!
# Command: openssl rand -hex 32

SECRET_KEY=your-secret-key-change-this-in-production-use-openssl-rand-hex-32
# Used for general encryption and signing

JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production-use-openssl-rand-hex-32
# Used for JWT token signing

JWT_ALGORITHM=HS256
# JWT algorithm (HS256, RS256, etc.)

JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Access token expiration (30 minutes recommended)

JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# Refresh token expiration (7 days recommended)

# ============================================
# OpenAI Configuration
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here
# Get your API key from: https://platform.openai.com/api-keys

OPENAI_MODEL=gpt-4
# Options: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo
# Note: gpt-3.5-turbo is cheaper but less capable

OPENAI_MAX_TOKENS=2000
# Maximum tokens per request (adjust based on your needs)

OPENAI_TEMPERATURE=0.7
# Temperature for responses (0.0 = deterministic, 1.0 = creative)

# ============================================
# Database Configuration (PostgreSQL)
# ============================================
POSTGRES_HOST=localhost
# Hostname or IP address of PostgreSQL server

POSTGRES_PORT=5432
# PostgreSQL port (default: 5432)

POSTGRES_DB=jarvis
# Database name

POSTGRES_USER=jarvis
# Database user

POSTGRES_PASSWORD=change-this-to-a-secure-password-min-16-chars
# Database password (MUST be changed in production!)

# Database URL (SQLAlchemy format)
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://jarvis:change-this-to-a-secure-password-min-16-chars@localhost:5432/jarvis

# SQLite (Development fallback)
SQLITE_DATABASE_PATH=./runtime/jarvis.db
# Used if PostgreSQL is not available

# ============================================
# Redis Configuration (Caching)
# ============================================
REDIS_HOST=localhost
# Redis server hostname

REDIS_PORT=6379
# Redis port (default: 6379)

REDIS_DB=0
# Redis database number (0-15)

REDIS_PASSWORD=
# Redis password (leave empty if no password set)

REDIS_MAX_CONNECTIONS=10
# Maximum number of Redis connections in pool

# ============================================
# File Paths
# ============================================
MEMORY_BASE_PATH=./memory
# Path to curated knowledge (Git-tracked)

RUNTIME_BASE_PATH=./runtime
# Path to instance-specific data (Git-ignored)

# ============================================
# Logging Configuration
# ============================================
LOG_LEVEL=INFO
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
# Use DEBUG for development, INFO for production

LOG_FORMAT=json
# Options: json, text
# JSON format recommended for production (easier to parse)

LOG_FILE=./runtime/logs/app.log
# Log file path (will be created automatically)

# ============================================
# Monitoring & Metrics
# ============================================
ENABLE_TELEMETRY=true
# Enable collection of usage metrics

PROMETHEUS_PORT=9090
# Port for Prometheus metrics endpoint

METRICS_ENABLED=true
# Enable performance metrics collection

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_PER_MINUTE=60
# Maximum requests per minute per client

RATE_LIMIT_PER_HOUR=1000
# Maximum requests per hour per client

# ============================================
# CORS (Cross-Origin Resource Sharing)
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8080
# Comma-separated list of allowed origins
# In production, replace with your actual domain(s)

CORS_ALLOW_CREDENTIALS=true
# Allow credentials (cookies, authorization headers)

# ============================================
# Agent Configuration
# ============================================
AGENT_TIMEOUT_SECONDS=30
# Maximum execution time per agent

AGENT_MAX_RETRIES=3
# Number of retry attempts on agent failure

AGENT_PARALLEL_EXECUTION=true
# Enable parallel agent execution (recommended)

# ============================================
# Memory Configuration
# ============================================
MEMORY_CACHE_TTL_SECONDS=3600
# Memory cache time-to-live (1 hour = 3600 seconds)

MEMORY_MAX_CACHE_SIZE_MB=100
# Maximum memory cache size in megabytes

# ============================================
# Feature Flags
# ============================================
ENABLE_WEBSOCKET=false
# Enable WebSocket real-time updates (planned for v2.0)

ENABLE_MULTI_USER=false
# Enable multi-user support (planned for v2.0)

ENABLE_GITHUB_INTEGRATION=false
# Enable GitHub integration (planned for v2.0)

ENABLE_SLACK_INTEGRATION=false
# Enable Slack integration (planned for v2.0)

ENABLE_VSCODE_INTEGRATION=false
# Enable VS Code extension integration (planned for v2.0)

# ============================================
# Frontend Configuration (React Web App)
# ============================================
VITE_API_URL=http://localhost:8000
# Backend API URL for frontend

VITE_WS_URL=ws://localhost:8000
# WebSocket URL for real-time updates

VITE_ENABLE_ANALYTICS=true
# Enable frontend analytics

# ============================================
# Email Configuration (Optional)
# ============================================
# Uncomment and configure if you need email notifications

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=noreply@jarvis.ai
# SMTP_USE_TLS=true

# ============================================
# Sentry Configuration (Optional)
# ============================================
# Uncomment and configure for error tracking

# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=1.0

# ============================================
# AWS Configuration (Optional)
# ============================================
# Uncomment if deploying to AWS

# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_S3_BUCKET=jarvis-storage

# ============================================
# Google Cloud Configuration (Optional)
# ============================================
# Uncomment if deploying to GCP

# GCP_PROJECT_ID=your-project-id
# GCP_REGION=us-central1
# GOOGLE_APPLICATION_CREDENTIALS=./credentials/gcp-key.json

# ============================================
# Development Tools
# ============================================
# Settings for local development only

DEV_RELOAD_DELAY=0.5
# Delay before auto-reload (seconds)

DEV_SKIP_MIGRATIONS=false
# Skip database migrations on startup

DEV_MOCK_OPENAI=false
# Use mock OpenAI responses (for testing without API key)

# ============================================
# Testing Configuration
# ============================================
TEST_DATABASE_URL=postgresql://jarvis:test@localhost:5432/jarvis_test
# Separate database for testing

TEST_REDIS_DB=1
# Separate Redis database for testing

# ============================================
# Performance Tuning
# ============================================
DB_POOL_SIZE=5
# Database connection pool size

DB_MAX_OVERFLOW=10
# Maximum overflow connections

DB_POOL_TIMEOUT=30
# Connection pool timeout (seconds)

DB_POOL_RECYCLE=3600
# Recycle connections after (seconds)

# ============================================
# Notes & Best Practices
# ============================================
# 
# 1. NEVER commit .env file to Git (it's in .gitignore)
# 2. Use strong, unique passwords for production
# 3. Generate secrets with: openssl rand -hex 32
# 4. Rotate secrets regularly (monthly recommended)
# 5. Use environment-specific .env files:
#    - .env.development
#    - .env.staging
#    - .env.production
# 6. For production, use secret management services:
#    - AWS Secrets Manager
#    - HashiCorp Vault
#    - Kubernetes Secrets
# 7. Keep this .env.example file updated when adding new variables
#
# ============================================