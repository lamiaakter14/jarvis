# ============================================
# JARVIS Configuration
# ============================================

# Environment (development, staging, production)
ENVIRONMENT=development

# ============================================
# API Configuration
# ============================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# ============================================
# Security
# ============================================
SECRET_KEY=your-secret-key-here-change-in-production
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ============================================
# OpenAI Configuration
# ============================================
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.7

# ============================================
# JARVIS V1 - REFLECTOR Agent Configuration
# ============================================
REFLECTOR_ENABLED=true
REFLECTOR_ANALYSIS_SCHEDULE=0 6 * * *
REFLECTOR_MIN_TASKS_FOR_ANALYSIS=3

# ============================================
# JARVIS V1 - Semantic Search & ML/NLU
# ============================================
SEMANTIC_SEARCH_ENABLED=true
EMBEDDING_MODEL=text-embedding-ada-002
EMBEDDING_DIMENSION=1536
VECTOR_SIMILARITY_THRESHOLD=0.7
MAX_SEMANTIC_RESULTS=10

# ============================================
# Database Configuration
# ============================================
DATABASE_URL=postgresql://jarvis:jarvis_password@localhost:5432/jarvis
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ============================================
# Redis Configuration
# ============================================
REDIS_URL=redis://localhost:6379/0
REDIS_MAX_CONNECTIONS=10

# ============================================
# Memory & Runtime Paths
# ============================================
MEMORY_BASE_PATH=memory
RUNTIME_BASE_PATH=runtime

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_FILE=runtime/logs/jarvis.log

# ============================================
# Monitoring
# ============================================
ENABLE_METRICS=true
METRICS_PORT=9090

# ============================================
# CORS Configuration
# ============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# ============================================
# Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60

# ============================================
# Third-Party Integrations
# ============================================

# Slack Bot (JARVIS V1)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_SIGNING_SECRET=your-signing-secret
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_ENABLED=false

# GitHub App (JARVIS V1)
GITHUB_APP_ID=your-app-id
GITHUB_PRIVATE_KEY_PATH=/path/to/private-key.pem
GITHUB_WEBHOOK_SECRET=your-webhook-secret
GITHUB_ENABLED=false

# VSCode Extension (JARVIS V1)
VSCODE_INTEGRATION_ENABLED=false
VSCODE_API_KEY=your-vscode-api-key

# ============================================
# Development Settings
# ============================================
DEBUG=true
TESTING=false
