# ============================================
# JARVIS .gitignore
# ============================================

# ============================================
# Runtime Directory (instance-specific data)
# ============================================
# Ignore all runtime content but keep structure
runtime/*
!runtime/.gitkeep
!runtime/*/
runtime/daily_context/*
!runtime/daily_context/.gitkeep
runtime/plans/*
!runtime/plans/.gitkeep
runtime/logs/*
!runtime/logs/.gitkeep
runtime/cache/*
!runtime/cache/.gitkeep
runtime/metrics/*
!runtime/metrics/.gitkeep

# Runtime database
runtime/episodic_memory.db
runtime/*.db
runtime/*.sqlite

# ============================================
# Python
# ============================================
# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# C extensions
*.so

